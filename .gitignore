# ===================================================
# UniFind — Campus Lost & Found Git Ignore Rules
# ===================================================

# Environment Variables & Secrets (NEVER push to GitHub)
.env
.env.*
!.env.example

# Personal Viva & Defense Notes (Keep private on local machine)
VIVA_GUIDE.md
viva_guide.md
*viva*

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# IDE & Editor Configuration
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs and databases
*.log
*.sqlite
*.sqlite3
tmp/
temp/
